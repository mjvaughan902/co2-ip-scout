# CO₂ Utilisation IP Scout — Environment Variables
# ─────────────────────────────────────────────────
# DO NOT commit this file to git. Add these as Vercel environment variables
# via the Vercel dashboard or CLI (see DEPLOY.md).

# Your EPO OPS Consumer Key (from developers.epo.org)
EPO_CONSUMER_KEY=your_epo_consumer_key_here

# Your EPO OPS Consumer Secret (from developers.epo.org)
EPO_CONSUMER_SECRET=your_epo_consumer_secret_here

# Your Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
